# Backend URL for the torrent service.
# If empty, the frontend falls back to the gateway pattern (?XTransformPort=3003)
# which only works in the Z.ai sandbox dev environment.
# For production (e.g. GitHub Pages), either:
#   - set this env var at build time, OR
#   - leave empty and configure at runtime via the settings icon in the header
# Example: NEXT_PUBLIC_TORRENT_API_URL=http://localhost:3003
NEXT_PUBLIC_TORRENT_API_URL=

# Prisma database URL (only used if you add Prisma models; the torrent app does not).
DATABASE_URL=file:/home/z/my-project/db/custom.db
